{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CONTRACT.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "vibe status *": "allow",
      "vibe validate*": "allow",
      "vibe push *": "ask",
      "vibe diag*": "allow",
      "ls*": "allow",
      "cat *": "allow"
    }
  }
}
